GOOGLE_MANAGER_ROOT_DIR=/srv/google-manager/Google_Manager
GOOGLE_MANAGER_ADMIN_PASSWORD=change-this-before-start
GOOGLE_MANAGER_BASE_PATH=/gm/
VITE_API_URL=/gm/api
GOOGLE_MANAGER_DATA_DIR=/srv/google-manager/data
GOOGLE_MANAGER_LOG_DIR=/run/user/1000/google-manager
GOOGLE_MANAGER_FRONTEND_MODE=static
GOOGLE_MANAGER_FRONTEND_BUILD_DIR=/run/user/1000/google-manager/build/gm
GOOGLE_MANAGER_STATIC_DEPLOY_ROOT=/var/www/gmanager-hdy-prod
GOOGLE_MANAGER_FRONTEND_HEALTHCHECK_URL=https://example.com/gm/
# Optional overrides
# GOOGLE_MANAGER_BACKEND_PORT=3001
# GOOGLE_MANAGER_FRONTEND_PORT=5173
# GOOGLE_MANAGER_FRONTEND_HOST=127.0.0.1
# GOOGLE_MANAGER_MASTER_KEY=your_32_byte_hex_or_base64_key
